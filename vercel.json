{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/"
    },
    {
      "src": "/pair",
      "dest": "/pair.html"
    },
    {
      "src": "/code",
      "methods": ["GET"],
      "dest": "/api/code"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
